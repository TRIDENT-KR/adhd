      "expect": {
        "count": 1,
        "function_name": "add_single_task",
        "category": "Routine",
        "time_is_null": true
      }
    },
    {
      "id": "KO02",
      "language": "ko",
      "description": "상대 시간 산술 - 2시간 뒤",
      "input": "지금부터 두 시간 뒤에 치과 예약 잡아줘",
      "expect": {
        "count": 1,
        "function_name": "add_single_task",
        "category": "Appointment",
        "time": "04:00 PM",
        "date": "2026-08-19"
      }
    },
    {
      "id": "KO03",
      "language": "ko",
      "description": "내일 특정 시각",
